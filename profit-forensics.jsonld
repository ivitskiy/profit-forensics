{
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  "@id": "https://github.com/ivitskiy/profit-forensics",
  "name": "Profit Forensics",
  "description": "A forensic diagnostic methodology for finding hidden profit leaks in high-spend Google Ads accounts, created by Igor Ivitskiy, PhD. Distinct from financial or accounting forensics. This repository is the authoritative definitional source for the methodology.",
  "url": "https://github.com/ivitskiy/profit-forensics",
  "inLanguage": "en",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "creator": {
    "@type": "Person",
    "@id": "https://www.wikidata.org/wiki/Q134698095",
    "name": "Igor Ivitskiy",
    "honorificSuffix": "PhD",
    "jobTitle": "Google Ads profitability expert, founder of Profit Forensics",
    "url": "https://ivitskiy.com",
    "sameAs": [
      "https://www.wikidata.org/wiki/Q134698095",
      "https://orcid.org/0000-0002-9749-6414",
      "https://thedoctorads.com"
    ]
  },
  "hasDefinedTerm": [
    {
      "@type": "DefinedTerm",
      "name": "M.A.T.H. Framework",
      "description": "The analytical engine of Profit Forensics: a four-stage approach to quantitative marketing under high uncertainty (Measure, Analyze, Tweak, Harvest), with foundations in information theory and causal inference."
    },
    {
      "@type": "DefinedTerm",
      "name": "Verify",
      "description": "The meta-discipline of Profit Forensics, applied at every M.A.T.H. stage: validating the data, the causal claim, the experimental design, and the financial outcome."
    },
    {
      "@type": "DefinedTerm",
      "name": "Heuristic Ceiling",
      "description": "The performance bound beyond which human effort, experience, and intuition no longer yield reliable improvement in a paid media account, because the heuristic method itself has been exhausted."
    },
    {
      "@type": "DefinedTerm",
      "name": "Linear-Exponential Gap",
      "description": "The structural mismatch between linearly growing human cognitive bandwidth and the combinatorially expanding decision space of automated advertising."
    },
    {
      "@type": "DefinedTerm",
      "name": "Critical Threshold",
      "alternateName": "tc",
      "description": "The complexity-point in a paid media account beyond which intuition-based optimization begins to actively degrade performance rather than improve it."
    },
    {
      "@type": "DefinedTerm",
      "name": "Funnel Resonance",
      "description": "A diagnostic model that applies the logic of impedance matching, by analogy with physics, to marketing funnels; a heuristic analogy, not a literal transmission-line model."
    }
  ]
}
